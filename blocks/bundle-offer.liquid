{%- doc -%}
  Renders "Buy more, save more" quantity tiers for the surrounding product. Tiers above one
  show a color/size choice per item and are added to cart together through the buy buttons
  in the same section. Discounts are displayed only; checkout pricing comes from matching
  Shopify automatic discounts.

  @example
  {% content_for 'block', type: 'bundle-offer', id: 'bundle-offer' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_variant = product.selected_or_first_available_variant

  assign default_tier = block_settings.default_tier | plus: 0
  assign best_value_tier = block_settings.best_value_tier | plus: 0
%}

{% unless product == blank or product.gift_card? or product.available == false %}
  <script
    src="{{ 'bundle-offer.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <bundle-offer-component
    class="bundle-offer spacing-style"
    style="{% render 'spacing-style', settings: block_settings %} --bundle-offer-badge-radius: {{ settings.badge_corner_radius }}px;{% if block_settings.card_background != blank %} --bundle-offer-card-background: {{ block_settings.card_background }};{% endif %}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
    data-active-quantity="{{ default_tier }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-unavailable-message="{{ 'products.bundle_offer.choose_available' | t | escape }}"
    data-skip-node-update
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.heading != blank -%}
      <h3 class="bundle-offer__heading h5" id="BundleOfferHeading-{{ block.id }}">
        <span>{{ block_settings.heading | escape }}</span>
      </h3>
    {%- endif -%}
    {%- if block_settings.subheading != blank -%}
      <p class="bundle-offer__subheading">{{ block_settings.subheading | escape }}</p>
    {%- endif -%}

    <fieldset class="bundle-offer__tiers">
      <legend class="visually-hidden">
        {{- block_settings.heading | default: block_settings.subheading | escape -}}
      </legend>

      {%- for quantity in (1..4) -%}
        {%- liquid
          assign discount = 0
          if quantity > 1
            assign discount_key = 'tier_' | append: quantity | append: '_discount'
            assign discount = block_settings[discount_key]
          endif

          assign tier_total = selected_variant.price | times: quantity
          assign tier_price = 100 | minus: discount | times: tier_total | divided_by: 100.0 | round
          assign input_id = 'BundleOffer-' | append: block.id | append: '-' | append: quantity
        -%}
        <div class="bundle-offer__tier{% if best_value_tier == quantity %} bundle-offer__tier--badged{% endif %}">
          <input
            type="radio"
            class="bundle-offer__radio"
            id="{{ input_id }}"
            name="bundle-offer-{{ block.id }}"
            value="{{ quantity }}"
            data-discount="{{ discount }}"
            ref="tierInputs[]"
            on:change="/handleTierChange"
            {% if quantity == default_tier %}
              checked
            {% endif %}
          >
          <label class="bundle-offer__tier-label" for="{{ input_id }}">
            <span class="bundle-offer__control" aria-hidden="true"></span>
            <span class="bundle-offer__tier-title">
              {{- 'products.bundle_offer.buy_quantity' | t: quantity: quantity -}}
            </span>
            {%- if discount > 0 -%}
              <span class="bundle-offer__saving">
                {{- 'products.bundle_offer.percent_off' | t: percent: discount -}}
              </span>
            {%- endif -%}
            <span class="bundle-offer__price">
              <span class="price" ref="tierPrices[]"
                ><bdi>{{ tier_price | money }}</bdi></span
              >
              {%- if discount > 0 -%}
                <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                <s class="compare-at-price" ref="tierCompares[]"
                  ><bdi>{{ tier_total | money }}</bdi></s
                >
              {%- endif -%}
            </span>
          </label>

          {%- if best_value_tier == quantity and block_settings.badge_text != blank -%}
            <span class="bundle-offer__badge">{{ block_settings.badge_text | escape }}</span>
          {%- endif -%}

          {%- if quantity > 1 -%}
            <div class="bundle-offer__items" data-quantity="{{ quantity }}">
              {%- for item in (1..quantity) -%}
                <div class="bundle-offer__item" ref="items[]">
                  <span class="bundle-offer__item-label">
                    {{- 'products.bundle_offer.item_number' | t: number: item -}}
                  </span>
                  {%- unless product.has_only_default_variant -%}
                    {%- liquid
                      assign name_prefix = input_id | append: '-' | append: item
                      assign legend_prefix = 'products.bundle_offer.item_number' | t: number: item
                    -%}
                    {% render 'variant-option-buttons',
                      product_resource: product,
                      name_prefix: name_prefix,
                      on_change: '/handleItemChange',
                      legend_prefix: legend_prefix,
                      compact: true
                    %}
                  {%- endunless -%}
                  <span class="bundle-offer__item-error" hidden>
                    {{- 'products.bundle_offer.unavailable' | t -}}
                  </span>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </fieldset>

    <p class="bundle-offer__error" role="status" ref="status"></p>

    <script type="application/json" ref="variantsData">
      [
        {%- for variant in product.variants -%}
          {"id":{{ variant.id }},"options":{{ variant.options | json }},"price":{{ variant.price }},"available":{{ variant.available }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </bundle-offer-component>
{% endunless %}

{% render 'price-styles' %}

{% stylesheet %}
  .bundle-offer {
    --bundle-offer-gap: var(--gap-sm);
    --bundle-offer-radius: var(--style-border-radius-inputs, var(--style-border-radius-md));

    display: flex;
    flex-direction: column;
    gap: var(--bundle-offer-gap);
    min-width: 0;
  }

  .bundle-offer__heading {
    display: flex;
    align-items: center;
    gap: var(--gap-md);
    margin: 0;
    text-align: center;

    &::before,
    &::after {
      content: '';
      flex: 1 1 0;
      border-block-start: var(--style-border-width) solid var(--color-border);
    }

    > span {
      flex: 0 1 auto;
      min-width: 0;
      overflow-wrap: anywhere;
    }
  }

  .bundle-offer__subheading {
    margin: 0;
    font-size: var(--font-size--sm);
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .bundle-offer__tiers {
    display: flex;
    flex-direction: column;
    gap: var(--bundle-offer-gap);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  /* Tier card colors follow the variant picker palette, matching PDP option buttons */
  .bundle-offer__tier {
    position: relative;
    border: var(--style-border-width, 1px) solid var(--color-variant-border);
    border-radius: var(--bundle-offer-radius);
    background-color: var(--bundle-offer-card-background, var(--color-variant-background));
    color: var(--color-variant-text);
    transition: border-color var(--animation-speed) var(--animation-easing),
      box-shadow var(--animation-speed) var(--animation-easing);

    &:hover {
      border-color: var(--color-variant-hover-border);
    }

    &:has(.bundle-offer__radio:checked) {
      border-color: var(--color-selected-variant-border);
      box-shadow: inset 0 0 0 1px var(--color-selected-variant-border);
    }

    &:has(.bundle-offer__radio:focus-visible) {
      outline: var(--focus-outline-width, 2px) solid var(--color-foreground);
      outline-offset: var(--focus-outline-offset, 2px);
    }
  }

  .bundle-offer__tier--badged {
    margin-block-start: var(--padding-xs);
  }

  .bundle-offer__radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .bundle-offer__tier-label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-lg);
    cursor: pointer;
  }

  .bundle-offer__control {
    flex: none;
    width: 20px;
    height: 20px;
    border: var(--style-border-width, 1px) solid currentColor;
    border-radius: 50%;
    opacity: var(--opacity-70, 0.7);
    transition: box-shadow var(--animation-speed) var(--animation-easing);
  }

  .bundle-offer__radio:checked + .bundle-offer__tier-label .bundle-offer__control {
    border-color: var(--color-selected-variant-background);
    box-shadow: inset 0 0 0 4px var(--bundle-offer-card-background, var(--color-variant-background)),
      inset 0 0 0 10px var(--color-selected-variant-background);
    opacity: 1;
  }

  .bundle-offer__tier-title {
    font-weight: 700;
    white-space: nowrap;
  }

  .bundle-offer__saving {
    padding: 2px var(--padding-xs);
    border-radius: var(--bundle-offer-badge-radius);
    background-color: var(--color-selected-variant-background);
    color: var(--color-selected-variant-text);
    font-size: var(--font-size--xs);
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bundle-offer__price {
    display: flex;
    margin-inline-start: auto;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    text-align: end;

    .compare-at-price {
      font-size: var(--font-size--xs);
    }
  }

  .bundle-offer__badge {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--padding-lg);
    transform: translateY(-50%);
    padding: 2px var(--padding-sm);
    border-radius: var(--bundle-offer-badge-radius);
    background-color: var(--color-selected-variant-background);
    color: var(--color-selected-variant-text);
    font-size: var(--font-size--xs);
    font-weight: 700;
    white-space: nowrap;
  }

  .bundle-offer__items {
    display: none;
    gap: var(--gap-sm);
    padding: 0 var(--padding-lg) var(--padding-lg);
  }

  .bundle-offer__tier:has(.bundle-offer__radio:checked) .bundle-offer__items {
    display: grid;
  }

  .bundle-offer__item {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    min-width: 0;
  }

  .bundle-offer__item + .bundle-offer__item {
    padding-block-start: var(--padding-md);
    border-block-start: var(--style-border-width, 1px) solid var(--color-variant-border);
  }

  .bundle-offer__item-label {
    font-size: var(--font-size--sm);
    font-weight: 700;
  }

  .bundle-offer__item-error {
    font-size: var(--font-size--xs);
    color: var(--color-error, #b3261e);
  }

  .bundle-offer__error:empty {
    display: none;
  }

  .bundle-offer__error {
    margin: 0;
    font-size: var(--font-size--sm);
    color: var(--color-error, #b3261e);
  }

  /* Multi-item tiers set their own quantities, so the single-item quantity and express checkout step aside */
  .shopify-section:has(.bundle-offer:not([data-active-quantity='1']))
    .product-form-buttons
    :is(.quantity-selector-wrapper, .quantity-label, .quantity-rules, .accelerated-checkout-block) {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .bundle-offer__tier-label {
      padding: var(--padding-md);
    }

    .bundle-offer__items {
      padding: 0 var(--padding-md) var(--padding-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bundle-offer__tier,
    .bundle-offer__control {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.bundle_offer",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Buy More, Save More"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.bundle_subheading",
      "default": "Get more of your favorite products"
    },
    {
      "type": "header",
      "content": "t:content.bundle_discounts"
    },
    {
      "type": "paragraph",
      "content": "t:content.bundle_discounts_info"
    },
    {
      "type": "range",
      "id": "tier_2_discount",
      "label": "t:settings.bundle_tier_2_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 5
    },
    {
      "type": "range",
      "id": "tier_3_discount",
      "label": "t:settings.bundle_tier_3_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "range",
      "id": "tier_4_discount",
      "label": "t:settings.bundle_tier_4_discount",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 10
    },
    {
      "type": "select",
      "id": "default_tier",
      "label": "t:settings.bundle_default_tier",
      "options": [
        {
          "value": "1",
          "label": "t:options.bundle_buy_1"
        },
        {
          "value": "2",
          "label": "t:options.bundle_buy_2"
        },
        {
          "value": "3",
          "label": "t:options.bundle_buy_3"
        },
        {
          "value": "4",
          "label": "t:options.bundle_buy_4"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "best_value_tier",
      "label": "t:settings.bundle_best_value_tier",
      "options": [
        {
          "value": "0",
          "label": "t:options.none"
        },
        {
          "value": "2",
          "label": "t:options.bundle_buy_2"
        },
        {
          "value": "3",
          "label": "t:options.bundle_buy_3"
        },
        {
          "value": "4",
          "label": "t:options.bundle_buy_4"
        }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:settings.bundle_badge_text",
      "default": "Best Value",
      "visible_if": "{{ block.settings.best_value_tier != '0' }}"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.bundle_card_background",
      "default": "#F5EDE5"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.bundle_offer",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
