{%- doc -%}
  Renders "Frequently bought together" for the surrounding product. The current item is
  rendered here; recommended items load from the `frequently-bought-together-items` section
  through the product recommendations endpoint (complementary first, then related). Selected
  items are added through the section's product form.

  @example
  {% content_for 'block', type: 'frequently-bought-together', id: 'frequently-bought-together' %}
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected_variant = product.selected_or_first_available_variant
%}

{% unless product == blank or product.gift_card? %}
  <script
    src="{{ 'frequently-bought-together.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  <frequently-bought-together-component
    class="fbt spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}{% if block_settings.card_background != blank %} --fbt-card-background: {{ block_settings.card_background }};{% endif %}"
    data-url="{{ routes.product_recommendations_url }}"
    data-section-id="frequently-bought-together-items"
    data-product-id="{{ product.id }}"
    data-limit="{{ block_settings.max_products }}"
    data-money-format="{{ shop.money_format | strip_html | escape }}"
    data-currency="{{ cart.currency.iso_code }}"
    data-skip-node-update
    hidden
    {{ block.shopify_attributes }}
  >
    <div class="fbt__card">
    {%- if block_settings.heading != blank -%}
      <h3 class="fbt__heading h5">{{ block_settings.heading | escape }}</h3>
    {%- endif -%}

    <ul class="fbt__list list-unstyled" ref="list">
      <li class="fbt__item fbt__item--current" data-fbt-item>
        <div class="fbt__summary">
          <input
            type="checkbox"
            class="fbt__checkbox"
            id="FbtCurrent-{{ block.id }}"
            aria-label="{{ 'products.frequently_bought_together.include' | t: title: product.title | escape }}"
            on:change="/handleChange"
            {% if selected_variant.available %}
              checked
            {% else %}
              disabled
            {% endif %}
          >
          <span class="fbt__media" aria-hidden="true">
            {%- if product.featured_media -%}
              {{
                product.featured_media
                | image_url: width: 160
                | image_tag: loading: 'lazy', widths: '80, 160', sizes: '80px', alt: ''
              }}
            {%- endif -%}
          </span>
          <div class="fbt__details">
            <span class="fbt__label">{{ 'products.frequently_bought_together.this_item' | t }}</span>
            <span class="fbt__title">{{ product.title | escape }}</span>
            <span class="fbt__variant" ref="currentVariantTitle">
              {%- unless product.has_only_default_variant -%}
                {{- selected_variant.title | escape -}}
              {%- endunless -%}
            </span>
            <input
              type="hidden"
              data-fbt-variant
              ref="currentVariant"
              value="{{ selected_variant.id }}"
              data-price="{{ selected_variant.price }}"
            >
          </div>
          <span class="fbt__price price" ref="currentPrice"
            ><bdi>{{ selected_variant.price | money }}</bdi></span
          >
        </div>
      </li>
    </ul>

    <div class="fbt__footer">
      <p class="fbt__total">
        {{ 'products.frequently_bought_together.total' | t }}
        <span class="price" ref="total"
          ><bdi>{{ selected_variant.price | money }}</bdi></span
        >
      </p>
      <button
        type="button"
        class="button fbt__button"
        ref="addButton"
        on:click="/handleAdd"
      >
        <span ref="addButtonText">{{ 'products.frequently_bought_together.add_selected' | t }}</span>
      </button>
    </div>

    </div>

    <script type="application/json" ref="variantsData">
      [
        {%- for variant in product.variants -%}
          {"id":{{ variant.id }},"title":{{ variant.title | json }},"price":{{ variant.price }},"available":{{ variant.available }}}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </frequently-bought-together-component>
{% endunless %}

{% render 'frequently-bought-together-styles' %}


{% schema %}
{
  "name": "t:names.frequently_bought_together",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Frequently bought together"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.fbt_max_products",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "paragraph",
      "content": "t:content.fbt_recommendations_info"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.bundle_card_background",
      "default": "#F5EDE5"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.frequently_bought_together",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
