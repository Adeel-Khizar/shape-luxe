

{% assign product = closest.product %}

{% capture children %}
  {% unless product == blank %}
    {%- if product.available == false or product.compare_at_price > product.price or product.tags contains 'Best Seller' or product.tags contains 'Selling Fast' -%}
      {%- if product.available == false or product.compare_at_price > product.price -%}
        <div class="product-badges product-badges--{{ settings.badge_position }}" style="--badge-border-radius: {{ settings.badge_corner_radius }}px; --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};">
          <div class="product-badges__badge product-badges__badge--rectangle {% if product.available == false %}color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %}color-custom-badge-sale{% endif %}">{%- if product.available == false -%}{{ 'content.product_badge_sold_out' | t }}{%- elsif product.compare_at_price > product.price -%}{{ 'content.product_badge_sale' | t }}{%- endif -%}</div>
        </div>
      {%- endif -%}
      {%- if product.tags contains 'Best Seller' -%}
        <div class="product-badges shape-luxe-badge-top-left" style="--badge-border-radius: {{ settings.badge_corner_radius }}px; --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};">
          <div class="product-badges__badge product-badges__badge--rectangle shape-luxe-tag-badge shape-luxe-tag-badge--best">✦ <span>Best Seller</span></div>
        </div>
      {%- endif -%}
      {%- if product.tags contains 'Selling Fast' -%}
        <div class="product-badges shape-luxe-badge-bottom-left" style="--badge-border-radius: {{ settings.badge_corner_radius }}px; --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};">
          <div class="product-badges__badge product-badges__badge--rectangle shape-luxe-tag-badge shape-luxe-tag-badge--selling">🔥 <span>Selling Fast</span></div>
        </div>
      {%- endif -%}
    {%- endif -%}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% stylesheet %}
.shape-luxe-tag-badge { display:inline-flex; align-items:center; gap:5px; color:#fff !important; padding:6px 10px; line-height:1.2; letter-spacing:.02em; font-size:12px; font-weight:700; text-transform:uppercase; border:1px solid rgba(255,255,255,.28); box-shadow:0 2px 8px rgba(25,25,25,.18); }
.product-badges .product-badges__badge.shape-luxe-tag-badge--best { background:#344f43 !important; background-color:#344f43 !important; color:#fffaf0 !important; }
.product-badges .product-badges__badge.shape-luxe-tag-badge--selling { background:#8b3544 !important; background-color:#8b3544 !important; color:#fff7f5 !important; }
.shape-luxe-badge-top-left { top: calc(var(--badge-inset) + var(--padding-block-start)); inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start)); }
.shape-luxe-badge-bottom-left { bottom: calc(var(--badge-inset) + var(--padding-block-start)); inset-inline-start: calc(var(--badge-inset) + var(--padding-inline-start)); }
{% endstylesheet %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
