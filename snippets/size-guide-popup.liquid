{% liquid
  assign size_guide = product_resource.metafields.custom.size_guide.value
  assign size_guide_image = size_guide.image.value
  assign has_inches = false
  assign has_cm = false
  if size_guide.inches_table.value != blank
    assign has_inches = true
  endif
  if size_guide.cm_table.value != blank
    assign has_cm = true
  endif
%}
{% if size_guide != blank %}
  <div class="size-guide" data-size-guide>
    <button type="button" class="size-guide__trigger" data-size-guide-open aria-haspopup="dialog" aria-controls="SizeGuideDialog-{{ product_resource.id }}">Size Guide</button>
    <dialog id="SizeGuideDialog-{{ product_resource.id }}" class="size-guide__dialog" aria-labelledby="SizeGuideTitle-{{ product_resource.id }}" data-size-guide-dialog>
      <div class="size-guide__panel">
        <button type="button" class="size-guide__close" data-size-guide-close aria-label="Close size guide"><span aria-hidden="true">&times;</span></button>
        <h2 class="size-guide__title" id="SizeGuideTitle-{{ product_resource.id }}">{{ size_guide.title.value | default: 'Size Guide' | escape }}</h2>
        {% if size_guide.introduction != blank %}<div class="size-guide__intro rte">{{ size_guide.introduction | metafield_tag }}</div>{% endif %}
        {% if size_guide_image != blank %}
          {% assign size_guide_alt = size_guide_image.alt | default: size_guide.title.value | default: 'Size guide' %}
          <div class="size-guide__image">
            {{ size_guide_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 800px) 700px, 100vw', alt: size_guide_alt }}
          </div>
        {% endif %}
        {% if has_inches and has_cm %}
          <div class="size-guide__tabs" role="tablist" aria-label="Measurement units">
            <button type="button" class="size-guide__tab is-active" role="tab" aria-selected="true" aria-controls="SizeGuideInches-{{ product_resource.id }}" data-size-guide-tab="inches">By Inches</button>
            <button type="button" class="size-guide__tab" role="tab" aria-selected="false" aria-controls="SizeGuideCm-{{ product_resource.id }}" data-size-guide-tab="cm">By cm</button>
          </div>
        {% endif %}
        {% if has_inches %}
          <div class="size-guide__table-wrap" id="SizeGuideInches-{{ product_resource.id }}"{% if has_cm %} role="tabpanel"{% endif %} data-size-guide-panel="inches">
            <div class="size-guide__table-container" data-size-guide-table="inches"></div>
            <script type="application/json" data-size-guide-data="inches">{{ size_guide.inches_table.value | json }}</script>
          </div>
        {% endif %}
        {% if has_cm %}
          <div class="size-guide__table-wrap" id="SizeGuideCm-{{ product_resource.id }}"{% if has_inches %} role="tabpanel" hidden{% endif %} data-size-guide-panel="cm">
            <div class="size-guide__table-container" data-size-guide-table="cm"></div>
            <script type="application/json" data-size-guide-data="cm">{{ size_guide.cm_table.value | json }}</script>
          </div>
        {% endif %}
      </div>
    </dialog>
  </div>
{% endif %}
{% render 'size-guide-styles' %}
<script src="{{ 'size-guide.js' | asset_url }}" type="module"></script>
