<div class="section section--page-width page-width-{{ settings.page_width }}">
  <nav class="shape-luxe-breadcrumbs" aria-label="Breadcrumb">
    <ol class="shape-luxe-breadcrumbs__list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {% if collection %}
        <li aria-hidden="true">/</li>
        <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
      {% elsif product.collections.first %}
        <li aria-hidden="true">/</li>
        <li><a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a></li>
      {% endif %}
      <li aria-hidden="true">/</li>
      <li aria-current="page">{{ product.title | escape }}</li>
    </ol>
  </nav>
</div>
<style>
.shape-luxe-breadcrumbs{padding-top:20px;padding-bottom:20px}.shape-luxe-breadcrumbs__list{display:flex;flex-wrap:wrap;align-items:center;gap:8px;list-style:none;margin:0;padding:0;}.shape-luxe-breadcrumbs a{color:inherit;text-decoration:none}.shape-luxe-breadcrumbs a:hover{text-decoration:underline;color:var(--color-foreground)}.shape-luxe-breadcrumbs [aria-current=page]{color:var(--color-foreground)}@media(max-width:749px){.shape-luxe-breadcrumbs{padding-top:10px;padding-bottom:8px}.shape-luxe-breadcrumbs__list{font-size:11px;gap:6px}}
</style>
{% schema %}
{
  "name": "Breadcrumbs",
  "tag": "section",
  "class": "section-breadcrumbs",
  "settings": [],
  "presets": [{"name": "Breadcrumbs"}]
}
{% endschema %}